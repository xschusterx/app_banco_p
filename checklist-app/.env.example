# Copie para .env e preencha (nunca commite o .env)
# cp .env.example .env

# --- Servidor (nunca exponha no frontend) ---

# Chave privada do Resend — só no servidor
RESEND_API_KEY=re_xxxxxxxx

# Remetente. Em testes: onboarding@resend.dev
# Em produção: domínio verificado, ex: Task-Flux <checklist@seuapp.com>
RESEND_FROM=Task-Flux <onboarding@resend.dev>

# Porta da API / servidor unificado (serve dist + /api + /install.apk)
PORT=8787

# production = exige APP_SEND_TOKEN e CORS restrito
# NODE_ENV=production

# Obrigatório em production: token no header X-App-Token
APP_SEND_TOKEN=troque-por-um-segredo-longo

# Origens permitidas (vírgula). Vazio em production = só same-origin / sem Origin.
# Ex.: https://seu-app.up.railway.app,https://www.seudominio.com
# CORS_ORIGIN=https://seu-app.exemplo.com

# --- Frontend / APK (build-time Vite) ---

# Vazio = mesma origem (/api/send-email). No Capacitor/Android use a URL pública HTTPS:
# VITE_EMAIL_API_URL=https://sua-api.exemplo.com

# Mesmo valor de APP_SEND_TOKEN quando o token estiver ativo:
# VITE_APP_SEND_TOKEN=troque-por-um-segredo-longo
