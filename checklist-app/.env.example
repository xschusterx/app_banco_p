# Copie para .env e preencha (nunca commite o .env)
# cp .env.example .env

# Chave privada do Resend — só no servidor
RESEND_API_KEY=re_xxxxxxxx

# Remetente. Em testes: onboarding@resend.dev
# Em produção: use domínio verificado, ex: Task-Flux <checklist@seuapp.com>
RESEND_FROM=Task-Flux <onboarding@resend.dev>

# Porta da API / servidor unificado
PORT=8787

# Opcional: token simples exigido no header X-App-Token (defesa extra)
# APP_SEND_TOKEN=troque-por-um-segredo-longo

# Frontend (Vite). Vazio = mesma origem (/api/send-email)
# No Android Capacitor, use a URL pública da API:
# VITE_EMAIL_API_URL=https://sua-api.exemplo.com
# VITE_APP_SEND_TOKEN=mesmo-valor-de-APP_SEND_TOKEN
